# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# archived/legacy scripts, not part of the app
/Archive

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
env.txt

# vercel
.vercel

# raw epub sources;
# only the ingested/validated JSON in content/books/ gets committed
/content/epub-source/*
!/content/epub-source/.gitkeep

# typescript
*.tsbuildinfo
next-env.d.ts

*.md

/.claude/

# python (ingestion/)
/ingestion/
# /ingestion/.venv
# /ingestion/.bin
# __pycache__/
# *.egg-info/
# .pytest_cache/

# audiobook mp3s; published to Supabase Storage, not committed
content/books/*/audiobooks/*.mp3

# rudimentary local-file storage for library-store (highlights/notes/
# position) — see app/api/library-data
/data/library.json

# recorded voice-note audio — see app/api/voice-notes
/data/voice-notes/

Archive/

migrations/

scripts/

content/

announcement-assets/


ingestion-pipeline/

ui-mockups/

remotion/
# Supabase -> Filebase migration state: manifest, local backups of every
# moved object, materials backups (scripts/migrate-storage-to-filebase.ts)
/storage-migration/
